PORT=3000
JWT_SECRET=development-only-jwt-secret-change-in-production

# DATABASE: TURSO (SQLite over HTTP / Serverless SQLite)
# Dapatkan gratis di https://turso.tech (100% gratis 500 database)
# Contoh URL: libsql://blk-cafe-youruser.turso.io
# Jika dikosongkan saat dev lokal, otomatis memakai SQLite lokal (cafe.sqlite)
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# OBJECT STORAGE: CLOUDINARY (Penyimpanan Foto Produk)
# Dapatkan gratis di https://cloudinary.com
# Jika dikosongkan, foto otomatis fallback ke data URI atau penyimpanan lokal
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Staff Admin Akun
ADMIN_EMAIL=admin@blokcafe.test
ADMIN_PASSWORD=CafeAdmin123!
CAFE_WHATSAPP=6281234567890
